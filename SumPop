import React, { useMemo, useState } from 'react';
import { AgGridReact } from 'ag-grid-react';
import { ColDef, StatusPanelDef } from 'ag-grid-community';
import 'ag-grid-enterprise'; // Enterprise 기능 활성화

const GridWithStatusBar = () => {
  const [rowData] = useState([
    { product: '사과', price: 1000, quantity: 5 },
    { product: '바나나', price: 2000, quantity: 3 },
    { product: '오렌지', price: 1500, quantity: 10 },
  ]);

  const [columnDefs] = useState<ColDef[]>([
    { field: 'product', headerName: '상품명' },
    { field: 'price', headerName: '가격' },
    { field: 'quantity', headerName: '수량' },
  ]);

  // 하단 상태 표시줄 설정
  const statusBar = useMemo<{ statusPanels: StatusPanelDef[] }>(() => {
    return {
      statusPanels: [
        {
          statusPanel: 'agAggregationComponent', // 드래그 영역의 합계, 평균, 최소/최대값 자동 계산
          align: 'right',
        },
      ],
    };
  }, []);

  return (
    <div className="ag-theme-quartz" style={{ height: 400, width: '100%' }}>
      <AgGridReact
        rowData={rowData}
        columnDefs={columnDefs}
        enableRangeSelection={true} // 드래그 범위 선택 활성화 (필수)
        statusBar={statusBar}       // 상태 표시줄 적용
      />
    </div>
  );
};

export default GridWithStatusBar;



