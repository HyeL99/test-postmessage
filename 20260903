const conditionToText = (
  condition: ParsedFilterCondition
): string => {
  const value = condition.value ?? '';
  const valueTo = condition.valueTo ?? '';

  switch (condition.operator) {
    case 'contains':
      return `*${value}*`;

    case 'notContains':
      return `!(*${value}*)`;

    case 'equals':
      return `=${value}`;

    case 'notEqual':
      return `!(=${value})`;

    case 'inRange':
      return `${value}...${valueTo}`;

    case 'notInRange':
      return `!(${value}...${valueTo})`;

    case 'startsWith':
      return `${value}*`;

    case 'notStartsWith':
      return `!(${value}*)`;

    case 'endsWith':
      return `*${value}`;

    case 'notEndsWith':
      return `!(*${value})`;

    case 'lessThan':
      return `<${value}`;

    case 'notLessThan':
      return `!(<${value})`;

    case 'lessThanOrEqual':
      return `<=${value}`;

    case 'notLessThanOrEqual':
      return `!(<=${value})`;

    case 'greaterThan':
      return `>${value}`;

    case 'notGreaterThan':
      return `!(>${value})`;

    case 'greaterThanOrEqual':
      return `>=${value}`;

    case 'notGreaterThanOrEqual':
      return `!(>=${value})`;

    case 'blank':
      return '<비어 있음>';

    case 'notBlank':
      return '!(<비어 있음>)';

    default:
      return '';
  }
};
------------------------
const conditionsToText = (
  conditions: ParsedFilterCondition[]
): string => {
  return conditions
    .map(conditionToText)
    .filter(Boolean)
    .join(', ');
};
