const makeModalFilterValues = () => {
  if (!gridApi) return {};

  const filterModel =
    gridApi.getFilterModel();

  const columns =
    gridApi.getColumns() ?? [];

  const result: Record<string, string> = {};

  Object.entries(filterModel).forEach(
    ([colId, model]) => {
      const column = columns.find(
        (col) => col.getColId() === colId
      );

      if (!column) return;

      const headerName =
        column.getColDef().headerName;

      if (!headerName) return;

      const fioriModel =
        model as FioriFilterModel;

      if (!fioriModel?.conditions?.length) {
        return;
      }

      result[headerName] =
        conditionsToText(
          fioriModel.conditions
        );
    }
  );

  return result;
};
