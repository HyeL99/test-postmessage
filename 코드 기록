import React, { useState, useRef } from 'react';

const PostMessageSender = () => {
  const [inputValue, setInputValue] = useState('');
  const iframeRef = useRef(null); // postMessage를 보낼 타겟 (예: iframe)

  const handleSendMessage = () => {
    const trimmedInput = inputValue.trim();
    let payloadToSend;

    // 1. 비어있거나 명시적으로 "null"을 입력한 경우 처리
    if (trimmedInput === '' || trimmedInput === 'null') {
      payloadToSend = null;
    } else {
      // 2. 객체(JSON) 형태인지 확인
      try {
        payloadToSend = JSON.parse(trimmedInput);
      } catch (error) {
        // 3. JSON 파싱에 실패하면 일반 텍스트로 취급
        payloadToSend = inputValue; 
      }
    }

    // --- postMessage 전송 로직 ---
    const targetWindow = iframeRef.current?.contentWindow;
    if (targetWindow) {
      // 보안을 위해 targetOrigin은 '*' 보다는 명확한 도메인을 지정하는 것이 좋습니다.
      const targetOrigin = '*'; 
      
      targetWindow.postMessage(
        { type: 'MY_CUSTOM_EVENT', payload: payloadToSend },
        targetOrigin
      );
      
      console.log('전송된 페이로드:', payloadToSend);
    } else {
      console.warn('postMessage를 보낼 타겟이 없습니다.');
    }
  };

  return (
    <div style={{ padding: '20px', display: 'flex', flexDirection: 'column', gap: '10px' }}>
      <h3>postMessage 페이로드 전송기</h3>
      
      <textarea
        value={inputValue}
        onChange={(e) => setInputValue(e.target.value)}
        placeholder='객체 {"key": "value"}, 텍스트, 혹은 null을 입력하세요'
        rows={6}
        style={{ width: '100%', maxWidth: '400px' }}
      />
      
      <button onClick={handleSendMessage} style={{ width: '100px' }}>
        메시지 전송
      </button>

      {/* 테스트용 타겟 iframe (실제 환경에 맞게 변경하세요) */}
      <iframe 
        ref={iframeRef} 
        src="about:blank" 
        title="target" 
        style={{ display: 'none' }} 
      />
    </div>
  );
};

export default PostMessageSender;


import React, { useRef, useState, useCallback, useMemo } from 'react';
import { AgGridReact } from 'ag-grid-react';
import { SelectionChangedEvent, ColDef } from 'ag-grid-community';

// 1. 데이터 타입 정의 (예시를 위해 무게 컬럼 추가)
interface RowData {
  id: number;
  productName: string;
  price: number;
  quantity: number;
  weight: number;
}

// 2. 합계 계산이 가능한 숫자형 '대상 컬럼' 정보 목록
const AVAILABLE_COLUMNS = [
  { field: 'price', label: '단가(원)' },
  { field: 'quantity', label: '수량(개)' },
  { field: 'weight', label: '무게(kg)' },
];

export const CommonGrid: React.FC = () => {
  const gridRef = useRef<AgGridReact>(null);
  
  // 🌟 State 1: 사용자가 외부에서 체크박스로 선택한 계산 대상 컬럼들 (초기값 지정 가능)
  const [targetColumns, setTargetColumns] = useState<string[]>(['price', 'quantity']);
  
  // 🌟 State 2: 그리드에서 현재 체크박스로 선택된 행(Row) 데이터들
  const [selectedRows, setSelectedRows] = useState<RowData[]>([]);

  const rowData: RowData[] = useMemo(() => [
    { id: 1, productName: '기계식 키보드', price: 150000, quantity: 2, weight: 1.2 },
    { id: 2, productName: '무선 마우스', price: 80000, quantity: 5, weight: 0.3 },
    { id: 3, productName: '모니터 암', price: 120000, quantity: 1, weight: 4.5 },
  ], []);

  const columnDefs: ColDef[] = useMemo(() => [
    { 
      field: 'id', 
      headerName: 'ID', 
      width: 100,
      checkboxSelection: true,
      headerCheckboxSelection: true 
    },
    { field: 'productName', headerName: '상품명', width: 150 },
    { field: 'price', headerName: '단가(원)', width: 120 },
    { field: 'quantity', headerName: '수량(개)', width: 120 },
    { field: 'weight', headerName: '무게(kg)', width: 120 },
  ], []);

  // 그리드 내 행 선택이 바뀔 때마다 State 업데이트
  const onSelectionChanged = useCallback((event: SelectionChangedEvent) => {
    setSelectedRows(event.api.getSelectedRows() as RowData[]);
  }, []);

  // 외부 UI 체크박스 토글 핸들러
  const handleColumnToggle = (field: string) => {
    setTargetColumns((prev) => 
      prev.includes(field) 
        ? prev.filter((f) => f !== field) // 이미 있으면 제거
        : [...prev, field]                // 없으면 추가
    );
  };

  // 🌟 핵심 로직: 선택된 행(selectedRows)이나 대상 컬럼(targetColumns)이 바뀔 때마다 합계 동적 재계산
  const dynamicSums = useMemo(() => {
    const totals: Record<string, number> = {};
    
    // 대상 컬럼들 초기화
    targetColumns.forEach(col => totals[col] = 0);

    // 선택된 행을 순회하며 동적으로 값 누적
    selectedRows.forEach(row => {
      targetColumns.forEach(col => {
        // 객체의 key 값으로 동적 접근하여 더하기
        totals[col] += (row[col as keyof RowData] as number) || 0;
      });
    });

    return totals;
  }, [selectedRows, targetColumns]);

  return (
    <div style={{ padding: '20px' }}>
      
      {/* 1. 외부 컬럼 선택 체크박스 영역 */}
      <div style={{ marginBottom: '15px' }}>
        <strong>계산할 컬럼 선택: </strong>
        {AVAILABLE_COLUMNS.map((col) => (
          <label key={col.field} style={{ marginLeft: '10px', cursor: 'pointer' }}>
            <input
              type="checkbox"
              checked={targetColumns.includes(col.field)}
              onChange={() => handleColumnToggle(col.field)}
            />
            {col.label}
          </label>
        ))}
      </div>

      {/* 2. 동적으로 계산된 합계 표시 영역 */}
      <div style={{ 
        marginBottom: '15px', padding: '15px', 
        backgroundColor: '#f8f9fa', border: '1px solid #dee2e6', borderRadius: '4px',
        display: 'flex', gap: '30px', minHeight: '54px'
      }}>
        {targetColumns.length === 0 ? (
          <span style={{ color: '#6c757d' }}>선택된 컬럼이 없습니다.</span>
        ) : (
          targetColumns.map(field => {
            const label = AVAILABLE_COLUMNS.find(c => c.field === field)?.label;
            return (
              <div key={field} style={{ fontWeight: 'bold', color: '#333' }}>
                총 선택 {label}: <span style={{ color: '#007bff' }}>
                  {dynamicSums[field]?.toLocaleString() || 0}
                </span>
              </div>
            );
          })
        )}
      </div>
      
      {/* 3. AgGrid 영역 */}
      <div className="ag-theme-quartz" style={{ width: '100%', height: '400px' }}>
        <AgGridReact
          ref={gridRef}
          rowData={rowData}
          columnDefs={columnDefs}
          rowSelection="multiple"
          onSelectionChanged={onSelectionChanged}
        />
      </div>
    </div>
  );
};






