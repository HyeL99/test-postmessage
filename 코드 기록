import React, { useState, useRef } from 'react';

const PostMessageSender = () => {
  const [inputValue, setInputValue] = useState('');
  const iframeRef = useRef(null); // postMessage를 보낼 타겟 (예: iframe)

  const handleSendMessage = () => {
    const trimmedInput = inputValue.trim();
    let payloadToSend;

    // 1. 비어있거나 명시적으로 "null"을 입력한 경우 처리
    if (trimmedInput === '' || trimmedInput === 'null') {
      payloadToSend = null;
    } else {
      // 2. 객체(JSON) 형태인지 확인
      try {
        payloadToSend = JSON.parse(trimmedInput);
      } catch (error) {
        // 3. JSON 파싱에 실패하면 일반 텍스트로 취급
        payloadToSend = inputValue; 
      }
    }

    // --- postMessage 전송 로직 ---
    const targetWindow = iframeRef.current?.contentWindow;
    if (targetWindow) {
      // 보안을 위해 targetOrigin은 '*' 보다는 명확한 도메인을 지정하는 것이 좋습니다.
      const targetOrigin = '*'; 
      
      targetWindow.postMessage(
        { type: 'MY_CUSTOM_EVENT', payload: payloadToSend },
        targetOrigin
      );
      
      console.log('전송된 페이로드:', payloadToSend);
    } else {
      console.warn('postMessage를 보낼 타겟이 없습니다.');
    }
  };

  return (
    <div style={{ padding: '20px', display: 'flex', flexDirection: 'column', gap: '10px' }}>
      <h3>postMessage 페이로드 전송기</h3>
      
      <textarea
        value={inputValue}
        onChange={(e) => setInputValue(e.target.value)}
        placeholder='객체 {"key": "value"}, 텍스트, 혹은 null을 입력하세요'
        rows={6}
        style={{ width: '100%', maxWidth: '400px' }}
      />
      
      <button onClick={handleSendMessage} style={{ width: '100px' }}>
        메시지 전송
      </button>

      {/* 테스트용 타겟 iframe (실제 환경에 맞게 변경하세요) */}
      <iframe 
        ref={iframeRef} 
        src="about:blank" 
        title="target" 
        style={{ display: 'none' }} 
      />
    </div>
  );
};

export default PostMessageSender;


import React, { useRef, useMemo } from 'react';
import { AgGridReact } from 'ag-grid-react';
import { ColDef, GridReadyEvent } from 'ag-grid-community';

// CSS 임포트 (v33 기준)
import 'ag-grid-community/styles/ag-grid.css';
import 'ag-grid-community/styles/ag-theme-quartz.css'; // v31+ 추천 테마

interface CommonGridProps {
  rowData: any[];
  columnDefs: ColDef[];
  // 향후 여기에 커스텀 이벤트 props를 추가할 예정입니다.
  // onMyCustomEvent?: (data: any) => void;
}

export const CommonGrid: React.FC<CommonGridProps> = ({ rowData, columnDefs }) => {
  const gridRef = useRef<AgGridReact>(null);

  const onGridReady = (params: GridReadyEvent) => {
    // 그리드 초기화 시 필요한 공통 로직
    params.api.sizeColumnsToFit();
  };

  return (
    <div className="ag-theme-quartz" style={{ width: '100%', height: '500px' }}>
      <AgGridReact
        ref={gridRef}
        rowData={rowData}
        columnDefs={columnDefs}
        onGridReady={onGridReady}
      />
    </div>
  );
};


