for (const column of gridApi.getColumns() ?? []) {
  const headerName =
    column.getColDef().headerName ?? '';

  const conditions =
    nextFilterConditionMap[headerName];

  const colId = column.getColId();

  if (!conditions?.length) {
    await gridApi.setColumnFilterModel(
      colId,
      null
    );

    continue;
  }

  const filterType =
    column.getColDef().filterParams?.filterType === 'number'
      ? 'number'
      : 'text';

  const positiveConditions = conditions.filter(
    (condition) =>
      !condition.operator.startsWith('not')
  );

  const negativeConditions = conditions.filter(
    (condition) =>
      condition.operator.startsWith('not')
  );

  const positiveAgConditions =
    positiveConditions
      .map((condition) =>
        toAgGridCondition(
          condition,
          filterType
        )
      )
      .filter(Boolean);

  const negativeAgConditions =
    negativeConditions
      .map((condition) =>
        toAgGridCondition(
          condition,
          filterType
        )
      )
      .filter(Boolean);

  const includeModel =
    positiveAgConditions.length === 0
      ? null
      : positiveAgConditions.length === 1
        ? positiveAgConditions[0]
        : {
            filterType,
            operator: 'OR',
            conditions:
              positiveAgConditions,
          };

  const excludeModel =
    negativeAgConditions.length === 0
      ? null
      : negativeAgConditions.length === 1
        ? negativeAgConditions[0]
        : {
            filterType,
            operator: 'AND',
            conditions:
              negativeAgConditions,
          };

  const model = {
    filterType: 'multi',
    filterModels: [
      includeModel,
      excludeModel,
    ],
  };

  await gridApi.setColumnFilterModel(
    colId,
    model
  );
}

