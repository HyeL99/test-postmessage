const notStartsWithOption = {
  displayKey: 'notStartsWith',
  displayName: '제외할 시작문자',
  predicate: (
    [filterValue]: string[],
    cellValue: string | null
  ) => {
    if (cellValue == null) return true;

    return !String(cellValue).startsWith(
      String(filterValue)
    );
  },
  numberOfInputs: 1 as const,
};

const notEndsWithOption = {
  displayKey: 'notEndsWith',
  displayName: '제외할 끝문자',
  predicate: (
    [filterValue]: string[],
    cellValue: string | null
  ) => {
    if (cellValue == null) return true;

    return !String(cellValue).endsWith(
      String(filterValue)
    );
  },
  numberOfInputs: 1 as const,
};

const notInRangeOption = {
  displayKey: 'notInRange',
  displayName: '사이에 없음',
  predicate: (
    [from, to]: number[],
    cellValue: number | null
  ) => {
    if (cellValue == null) return true;

    return !(
      cellValue >= from &&
      cellValue <= to
    );
  },
  numberOfInputs: 2 as const,
};

