/* 팝업 기본 상태 (숨김 처리) */
/* 공통 팝업 스타일 */
.ag-sum-popup {
  background-color: #1e1e2f;
  color: #ffffff;
  padding: 16px 24px;
  border-radius: 12px;
  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
  display: flex;
  align-items: center;
  gap: 16px;
  z-index: 1000;
  
  /* 마우스 이벤트 통과 (필수) */
  pointer-events: none; 
  
  /* 애니메이션 설정 */
  opacity: 0;
  visibility: hidden;
  transform: translateY(20px);
  transition: opacity 0.3s ease, transform 0.3s ease, visibility 0.3s ease;
}

/* 옵션 A: 그리드 내부 우측 하단 (기획안 1안용) */
.ag-sum-popup.type-absolute {
  position: absolute;
  bottom: 24px;
  right: 24px;
}

/* 옵션 B: 브라우저 전체 우측 하단 (기획안 2안용) */
.ag-sum-popup.type-fixed {
  position: fixed;
  bottom: 40px;
  right: 40px;
}

/* 팝업 활성화 상태 */
.ag-sum-popup.visible {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
}

