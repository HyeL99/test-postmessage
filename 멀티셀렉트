import React, { useState, useCallback, useMemo, useEffect } from 'react';
import { AgGridReact } from 'ag-grid-react';
import { ColDef, SelectionChangedEvent, CellClickedEvent } from 'ag-grid-community';
import 'ag-grid-community/styles/ag-grid.css';
import 'ag-grid-community/styles/ag-theme-quartz.css';

// 1. 데이터 타입 정의 (인덱스 시그니처 추가하여 동적 접근 허용)
interface IRowData {
  id: number;
  product: string;
  price: number;
  stock: number; // 합산 테스트용 두 번째 숫자 컬럼
  [key: string]: any; 
}

const DynamicAgGridSumPopup = () => {
  // 상태 관리
  const [selectedRows, setSelectedRows] = useState<IRowData[]>([]);
  const [activeCol, setActiveCol] = useState<{ id: string; name: string } | null>(null);
  const [sumAmount, setSumAmount] = useState<number>(0);
  const [isPopupVisible, setIsPopupVisible] = useState<boolean>(false);

  // 더미 데이터
  const rowData: IRowData[] = useMemo(() => [
    { id: 1, product: '키보드', price: 150000, stock: 45 },
    { id: 2, product: '마우스', price: 80000, stock: 120 },
    { id: 3, product: '모니터', price: 450000, stock: 15 },
    { id: 4, product: '헤드셋', price: 120000, stock: 30 },
  ], []);

  // 컬럼 정의
  const columnDefs: ColDef<IRowData>[] = useMemo(() => [
    { field: 'product', headerName: '상품명', checkboxSelection: true, headerCheckboxSelection: true },
    { field: 'price', headerName: '가격', valueFormatter: (p) => `${p.value?.toLocaleString()} 원` },
    { field: 'stock', headerName: '재고수량', valueFormatter: (p) => `${p.value?.toLocaleString()} 개` },
  ], []);

  // 2. 셀 클릭 이벤트: 유저가 클릭한 컬럼 추적
  const onCellClicked = useCallback((event: CellClickedEvent<IRowData>) => {
    setActiveCol({
      id: event.column.getColId(),
      name: event.column.getColDef().headerName || event.column.getColId(),
    });
  }, []);

  // 3. 선택 변경 이벤트: 선택된 행 데이터 업데이트
  const onSelectionChanged = useCallback((event: SelectionChangedEvent<IRowData>) => {
    setSelectedRows(event.api.getSelectedRows());
  }, []);

  // 4. 합계 계산 로직 (선택 행 또는 타겟 컬럼이 바뀔 때마다 실행)
  useEffect(() => {
    if (selectedRows.length > 0 && activeCol) {
      // 선택된 행 중, 해당 컬럼의 값이 숫자인 데이터만 추출하여 합산
      let hasNumericValue = false;
      
      const total = selectedRows.reduce((acc, row) => {
        const val = row[activeCol.id];
        if (typeof val === 'number') {
          hasNumericValue = true;
          return acc + val;
        }
        return acc;
      }, 0);

      // 숫자 데이터가 있는 컬럼일 때만 팝업 노출
      if (hasNumericValue) {
        setSumAmount(total);
        setIsPopupVisible(true);
      } else {
        setIsPopupVisible(false);
      }
    } else {
      setIsPopupVisible(false);
      setSumAmount(0);
    }
  }, [selectedRows, activeCol]);

  return (
    <div style={{ position: 'relative', width: '100%', height: '500px' }}>
      <div className="ag-theme-quartz" style={{ height: '100%', width: '100%' }}>
        <AgGridReact<IRowData>
          rowData={rowData}
          columnDefs={columnDefs}
          rowSelection={{ mode: 'multiRow' }}
          onSelectionChanged={onSelectionChanged}
          onCellClicked={onCellClicked}
        />
      </div>

      {/* 팝업 UI */}
      {isPopupVisible && activeCol && (
        <div style={{
          position: 'absolute',
          bottom: '20px',
          right: '20px',
          backgroundColor: '#282c34',
          color: 'white',
          padding: '16px 24px',
          borderRadius: '8px',
          boxShadow: '0 4px 6px rgba(0,0,0,0.3)',
          zIndex: 1000,
          display: 'flex',
          alignItems: 'center',
          gap: '12px'
        }}>
          <span>선택된 <strong>[{activeCol.name}]</strong> 합계:</span>
          <strong style={{ fontSize: '1.2em', color: '#61dafb' }}>
            {sumAmount.toLocaleString()}
          </strong>
        </div>
      )}
    </div>
  );
};

export default DynamicAgGridSumPopup;
