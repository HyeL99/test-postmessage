import React, { useState, useCallback, useMemo } from 'react';
import { AgGridReact } from 'ag-grid-react';
import { ColDef, SelectionChangedEvent } from 'ag-grid-community';
import 'ag-grid-community/styles/ag-grid.css';
import 'ag-grid-community/styles/ag-theme-quartz.css'; // 최신 v31+ 권장 테마

// 1. 데이터 타입 정의
interface IRowData {
  id: number;
  product: string;
  price: number; // 합산을 진행할 대상 컬럼
}

const AgGridSumPopup = () => {
  // 팝업에 표시할 상태값
  const [sumAmount, setSumAmount] = useState<number>(0);
  const [isPopupVisible, setIsPopupVisible] = useState<boolean>(false);

  // 더미 데이터
  const rowData: IRowData[] = useMemo(() => [
    { id: 1, product: '키보드', price: 150000 },
    { id: 2, product: '마우스', price: 80000 },
    { id: 3, product: '모니터', price: 450000 },
    { id: 4, product: '헤드셋', price: 120000 },
  ], []);

  // 컬럼 정의 (첫 번째 컬럼에 체크박스 추가)
  const columnDefs: ColDef<IRowData>[] = useMemo(() => [
    { field: 'product', headerName: '상품명', checkboxSelection: true, headerCheckboxSelection: true },
    { field: 'price', headerName: '가격', valueFormatter: (p) => `${p.value.toLocaleString()} 원` },
  ], []);

  // 2. 선택 변경 이벤트 핸들러
  const onSelectionChanged = useCallback((event: SelectionChangedEvent<IRowData>) => {
    // 선택된 전체 행 데이터 가져오기
    const selectedRows = event.api.getSelectedRows();

    if (selectedRows.length > 0) {
      // 선택된 행들의 price 합산 계산
      const total = selectedRows.reduce((acc, row) => acc + (row.price || 0), 0);
      setSumAmount(total);
      setIsPopupVisible(true);
    } else {
      setIsPopupVisible(false);
      setSumAmount(0);
    }
  }, []);

  return (
    <div style={{ position: 'relative', width: '100%', height: '500px' }}>
      <div className="ag-theme-quartz" style={{ height: '100%', width: '100%' }}>
        <AgGridReact<IRowData>
          rowData={rowData}
          columnDefs={columnDefs}
          // ag-grid v32+ 부터는 객체 형태의 rowSelection 권장
          rowSelection={{ mode: 'multiRow' }} 
          onSelectionChanged={onSelectionChanged}
        />
      </div>

      {/* 3. 합계 표시 팝업 (플로팅 UI) */}
      {isPopupVisible && (
        <div style={{
          position: 'absolute',
          bottom: '20px',
          right: '20px',
          backgroundColor: '#282c34',
          color: 'white',
          padding: '16px 24px',
          borderRadius: '8px',
          boxShadow: '0 4px 6px rgba(0,0,0,0.3)',
          zIndex: 1000,
          display: 'flex',
          alignItems: 'center',
          gap: '12px'
        }}>
          <span>선택된 항목 합계:</span>
          <strong style={{ fontSize: '1.2em' }}>{sumAmount.toLocaleString()} 원</strong>
        </div>
      )}
    </div>
  );
};

export default AgGridSumPopup;
